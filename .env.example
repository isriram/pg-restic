# Project variables
# These values are interpolated into compose.yaml and passed to services via env_file.
# 1. PostgreSQL Connection Details
# Name of the PostgreSQL service in compose.yaml
PGHOST=postgres_docker_container_name
# Postgres port. Only needed if it isn't the default 5432.
# PGPORT=5432
# Postgres user with read-only access to the database(s) you want to backup
PGUSER=postgres_readonly_user
# Postgres user password
PGPASSWORD=hunter2

# 2. S3 compatible API Credentials
# S3 credentials - some call it key id, others call it account id.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# 3. Restic Encryption Password - You choose this; restic encrypts the repository with it when it is first initialized.
# You can generate a new password using the following command: `openssl rand -hex 32`
# REQUIRED: Keep this safe. You will need it on your machine to restore.
RESTIC_PASSWORD=add-your-restic-password-here

# Host name recorded on snapshots. Keep it fixed so retention keeps working when the container is recreated.
RESTIC_HOST=pg-restic

# Replace with your bucket name and region. For example, if your bucket is in the us-east-1 region, use s3:s3.us-east-1.amazonaws.com/bucket-name
RESTIC_REPOSITORY=s3:s3.us-east-005.backblazeb2.com/backup-bucket-name

# When to back up, in cron format
CRON_SCHEDULE=0 * * * *

# Retention: after each backup, restic forgets snapshots beyond these counts
RESTIC_KEEP_HOURLY=24
RESTIC_KEEP_DAILY=31
RESTIC_KEEP_MONTHLY=12

# When to free the space used by forgotten snapshots, in cron format. Defaults to daily at 03:30.
# PRUNE_SCHEDULE=30 3 * * *

# Optional heartbeat monitor URLs (e.g. healthchecks.io), visited after each successful backup / prune
# PING_URL=
# PRUNE_PING_URL=
